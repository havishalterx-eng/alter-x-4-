{
  "name": "platform-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/platform-api/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/apps/platform-api"
      ],
      "options": {
        "command": "tsc -p apps/platform-api/tsconfig.app.json"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "node dist/apps/platform-api/main.js"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "eslintConfig": "apps/platform-api/eslint.config.mjs",
        "lintFilePatterns": [
          "apps/platform-api/src/**/*.ts"
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/platform-api/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config apps/platform-api/vitest.config.ts --coverage"
      }
    },
    "test-db-integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run apps/platform-api/src/db/db.migration.spec.ts apps/platform-api/src/identity/session-store.integration.spec.ts"
      }
    }
  },
  "tags": []
}
