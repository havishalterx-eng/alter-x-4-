{
  "name": "provisioning-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/provisioning-service/src",
  "targets": {
    "build": { "executor": "nx:run-commands", "outputs": ["{workspaceRoot}/dist/apps/provisioning-service"], "options": { "command": "tsc -p apps/provisioning-service/tsconfig.app.json" } },
    "serve": { "executor": "nx:run-commands", "dependsOn": ["build"], "options": { "command": "node dist/apps/provisioning-service/main.js" } },
    "lint": { "executor": "@nx/eslint:lint", "options": { "eslintConfig": "apps/provisioning-service/eslint.config.mjs", "lintFilePatterns": ["apps/provisioning-service/src/**/*.ts"] } },
    "typecheck": { "executor": "nx:run-commands", "options": { "command": "tsc --noEmit -p apps/provisioning-service/tsconfig.json" } },
    "test": { "executor": "nx:run-commands", "options": { "command": "vitest run apps/provisioning-service/src/**/*.spec.ts" } }
  },
  "tags": ["type:service", "security-critical"]
}
