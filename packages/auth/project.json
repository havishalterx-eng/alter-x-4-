{
  "name": "auth",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/auth/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "tsc -p packages/auth/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "eslintConfig": "packages/auth/eslint.config.mjs",
        "lintFilePatterns": [
          "packages/auth/src/**/*.ts",
          "packages/auth/session-gateway/**/*.ts"
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p packages/auth/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run packages/auth/src packages/auth/session-gateway"
      }
    },
    "coverage": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "{projectRoot}/coverage"
      ],
      "options": {
        "command": "vitest run packages/auth/session-gateway/src --exclude packages/auth/session-gateway/src/session-gateway.rls.integration.spec.ts --coverage --coverage.include=packages/auth/session-gateway/src/m2m-validator.ts --coverage.include=packages/auth/session-gateway/src/actor-token-validator.ts --coverage.include=packages/auth/session-gateway/src/session-gateway.guard.ts --coverage.thresholds.lines=90 --coverage.thresholds.branches=90"
      }
    }
  },
  "tags": []
}
