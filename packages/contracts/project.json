{
  "name": "contracts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/contracts/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "tsc -p packages/contracts/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "eslintConfig": "packages/contracts/eslint.config.mjs",
        "lintFilePatterns": [
          "packages/contracts/src/**/*.ts"
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p packages/contracts/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "vitest run packages/contracts/src"
      }
    },
    "proto": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "buf lint",
          "buf build"
        ],
        "cwd": "packages/contracts/proto",
        "parallel": false
      }
    },
    "generate": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "{workspaceRoot}/packages/contracts/openapi.json"
      ],
      "options": {
        "command": "node packages/contracts/scripts/generate-openapi.mjs"
      }
    }
  },
  "tags": []
}
