{
  "name": "adapters",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/adapters/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "tsc -p packages/adapters/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "eslintConfig": "packages/adapters/eslint.config.mjs",
        "lintFilePatterns": [
          "packages/adapters/src/**/*.ts"
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p packages/adapters/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "vitest run --config packages/adapters/vitest.config.ts"
      }
    },
    "coverage": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "{projectRoot}/coverage"
      ],
      "options": {
        "command": "vitest run --coverage --config packages/adapters/vitest.config.ts"
      }
    }
  },
  "tags": [
    "type:adapter"
  ]
}
