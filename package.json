    "dev:mock-auth0": "node scripts/local-mock-auth0/server.js"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.28",
    "@nx/eslint": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/nest": "23.1.1",
    "@nx/next": "23.1.1",
    "@nx/vite": "23.1.1",
    "@types/node": "^22.19.11",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "nx": "23.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": "^8.5.23",
      "brace-expansion@<1.1.17": "^1.1.17",
