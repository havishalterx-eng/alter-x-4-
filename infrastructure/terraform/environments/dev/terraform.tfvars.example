aws_region = "ap-south-1"
aws_partition = "aws"
mock_provider = false
configuration = {
  account_id = "000000000000"
  target_role_arn = "arn:aws:iam::000000000000:role/REPLACE_WITH_BOOTSTRAP_ROLE"
  budget = { limit_usd = 200, thresholds = [80, 100], alert_email = "aws-budgets@example.invalid" }
  ci = {
    principal_arn = "arn:aws:iam::000000000000:role/REPLACE_WITH_SHARED_SERVICES_CI_ROLE"
    external_id = "replace-with-ci-external-id"
    actions = ["ecs:DescribeServices", "ecs:UpdateService", "iam:PassRole"]
    global_actions = ["ecs:RegisterTaskDefinition"]
    resource_arns = ["arn:aws:ecs:ap-south-1:000000000000:service/alter-dev/*", "arn:aws:ecs:ap-south-1:000000000000:task-definition/alter-dev-*", "arn:aws:iam::000000000000:role/alter-dev-*"]
  }
  foundation = {
    aurora_engine_version = "16.6"
    aurora_parameter_group_family = "aurora-postgresql16"
    aurora_min_capacity = 0.5
    aurora_max_capacity = 4
    backup_retention_days = 7
    deletion_protection = false
    redis_engine_version = "7.1"
    redis_node_type = "cache.t4g.small"
    redis_snapshot_retention_days = 7
  }
  network = {
    vpc_cidr = "10.20.0.0/16"
    availability_zones = ["ap-south-1a", "ap-south-1b"]
    public_subnet_cidrs = ["10.20.0.0/24", "10.20.1.0/24"]
    private_subnet_cidrs = ["10.20.10.0/24", "10.20.11.0/24"]
    nat_gateway_strategy = "single"
    flow_log_retention_days = 365
  }
}
