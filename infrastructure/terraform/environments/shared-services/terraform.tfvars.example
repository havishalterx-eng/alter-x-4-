aws_region    = "ap-south-1"
aws_partition = "aws"
mock_provider = false
configuration = {
  account_id      = "000000000000"
  target_role_arn = "arn:aws:iam::000000000000:role/REPLACE_WITH_BOOTSTRAP_ROLE"
  budget = { limit_usd = 300, thresholds = [80, 100], alert_email = "aws-budgets@example.invalid" }
  ci = {
    principal_arn = "arn:aws:iam::000000000000:role/REPLACE_WITH_SHARED_SERVICES_CI_ROLE"
    external_id = "replace-with-ci-external-id"
    actions = ["ecr:BatchCheckLayerAvailability", "ecr:CompleteLayerUpload", "ecr:InitiateLayerUpload", "ecr:PutImage", "ecr:UploadLayerPart"]
    global_actions = ["ecr:GetAuthorizationToken"]
    resource_arns = ["arn:aws:ecr:ap-south-1:000000000000:repository/alter-*" ]
  }
  network = {
    vpc_cidr = "10.10.0.0/16"
    availability_zones = ["ap-south-1a", "ap-south-1b"]
    public_subnet_cidrs = ["10.10.0.0/24", "10.10.1.0/24"]
    private_subnet_cidrs = ["10.10.10.0/24", "10.10.11.0/24"]
    nat_gateway_strategy = "per_az"
    flow_log_retention_days = 365
  }
}
